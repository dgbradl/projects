# Copy to .env to apply locally: cp .env.example .env
# .env is loaded automatically by `npm run dev` / `npm start`.
# Every value here is optional — unset vars fall back to the defaults in
# src/index.ts.

# --- Ollama / flavor ---
# Custom models built from server/ollama/*.Modelfile (see that folder's
# README). Leave unset to use the stock llama3.1:8b base model.
OLLAMA_MODEL=wayfarers-flavor
CHRONICLE_MODEL=wayfarers-keeper

# OLLAMA_BASE_URL=http://localhost:11434
# FLAVOR_MODE=llm            # llm | placeholder | recorded
